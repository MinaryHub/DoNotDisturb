{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "rm -rf dist && BASE_PATH=/donotdisturb/ npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/donotdisturb/", "permanent": false },
    { "source": "/donotdisturb", "destination": "/donotdisturb/", "permanent": false }
  ],
  "headers": [
    { "source": "/donotdisturb/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/donotdisturb/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/donotdisturb/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
